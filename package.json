{
  "name": "waretrack",
  "version": "5.8.0",
  "private": true,
  "description": "A self-building isometric logistics park: road, rail, sea and air freight feeding a live multi-stage supply chain.",
  "type": "module",
  "license": "MIT",
  "author": "Jonah",
  "scripts": {
    "start": "node scripts/serve.mjs",
    "start:dist": "npm run build && node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "npm run test:static && npm run build && npm run test:sim",
    "test:static": "node tests/static.mjs",
    "test:sim": "node tests/sim.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "devDependencies": {
    "puppeteer": "^25.13.0"
  },
  "engines": {
    "node": ">=22.12"
  },
  "allowScripts": {
    "puppeteer": true
  }
}
